PORT=8080

# Which LLM to use: "groq" (free, no card, fastest -- recommended) or "anthropic" (paid)
LLM_PROVIDER=groq

# --- Groq (free) ---
# Get a free key at https://console.groq.com -- no card required, never expires
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# --- Anthropic (paid, no ongoing free tier) ---
# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# --- Deepgram (free trial credit) ---
DEEPGRAM_API_KEY=...

# --- ElevenLabs (free tier available) ---
ELEVENLABS_API_KEY=...
# Pick an Australian voice from ElevenLabs' voice library (Voices -> filter Accent: Australian)
ELEVENLABS_VOICE_ID=...
